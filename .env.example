# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored — never commit real credentials.
#
# If you leave these blank (or delete .env), the backend automatically falls
# back to a local SQLite database (data/attendance.db) — nothing breaks.

# Supabase → Settings → API → Project URL
PROJECT_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Settings → Database → Connection string → URI
# (replace [YOUR-PASSWORD] with your database password)
Database_connection=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
